def now():
    return datetime.now(ZoneInfo(cfg.timezone))
def day():
    return now().date().isoformat()
def days(n):
    if n%10==1 and n%100!=11: w="день"
    elif n%10 in (2,3,4) and n%100 not in (12,13,14): w="дня"
    else: w="дней"
    return f"{n} {w}"

