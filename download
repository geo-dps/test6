@dp.message(Command("invite"))
async def invite(m:Message):
    parts=m.text.split(maxsplit=1)
    if len(parts)!=2 or not parts[1].lstrip("-").isdigit():
        await m.answer("Использование: <code>/invite USER_ID</code>")
        return
    partner=int(parts[1])
    if partner==m.from_user.id:
        await m.answer("Нельзя создать огонёк с самим собой 🙂")
        return
    await db.upsert_user(m.from_user, now().isoformat())
    try:
        partner_chat=await bot.get_chat(partner)
        await db.create_spark(m.from_user.id, partner, now().isoformat())
        spark=await db.get_spark(m.from_user.id, partner)
        kb=InlineKeyboardMarkup(inline_keyboard=[[
            InlineKeyboardButton(text="🔥 Принять", callback_data=f"accept:{spark['id']}"),
            InlineKeyboardButton(text="❌ Отклонить", callback_data=f"decline:{spark['id']}")
        ]])
        await bot.send_message(
            partner,
            f"🔥 <b>Вам предлагают держать огонёк!</b>\n\n"
            f"<b>{m.from_user.full_name}</b> хочет начать с вами огонёк.\n\n"
            "Каждый день, когда вы оба общаетесь, серия увеличивается.\n"
            "Один полный день без переписки — серия прерывается.",
            reply_markup=kb)
        await m.answer(f"📨 Приглашение отправлено: <b>{partner_chat.full_name}</b>")
    except Exception as e:
        log.exception("invite failed")
        await m.answer("❌ Не удалось отправить приглашение. Проверьте USER_ID и доступность пользователя.")

@dp.message(Command("streak"))
