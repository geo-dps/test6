    rows=await db.active_for_user(m.from_user.id)
    if not rows:
        await m.answer("🔥 <b>У вас пока нет активных огоньков.</b>\n\nИспользуйте /invite USER_ID.")
        return
    await send_my_streaks(m.chat.id, m.from_user.id, rows)

async def send_my_streaks(chat_id, uid, rows):
    lines=["<b>🔥 МОИ ОГОНЬКИ</b>\n"]
    for s in rows:
        partner=s["partner_id"] if s["owner_id"]==uid else s["owner_id"]
        st=await db.state(s["id"])
        n=st["streak"] if st else 0
        a=await db.today_activity(s["id"],day())
        both=bool(a and a["owner_active"] and a["partner_active"])
        status="🔥 Сегодня засчитан" if both else "⏳ Ждём общения"
        lines.append(f"👤 <b>{await name(partner)}</b>\n🔥 Серия: <b>{days(n)}</b>\n{status}\n")
    await bot.send_message(chat_id,"\n".join(lines),reply_markup=menu())

