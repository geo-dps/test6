@dp.callback_query(F.data.startswith("accept:"))
async def accept(c:CallbackQuery):
    sid=int(c.data.split(":")[1])
    # Verify recipient is the partner of this spark.
    rows=await db.active_for_user(c.from_user.id)
    # Fetch through pending ownership scan is intentionally avoided by broad DB helper limitation;
    # use a direct safe query via helper extension below.
    spark=await pending_for_recipient(sid,c.from_user.id)
    if not spark:
        await c.answer("Приглашение недоступно",show_alert=True); return
    await db.accept_spark(sid,now().isoformat())
    await c.message.edit_text("🔥 <b>Огонёк принят!</b>\n\nТеперь каждый день общения будет увеличивать вашу серию.")
    await bot.send_message(spark["owner_id"],f"🔥 <b>{c.from_user.full_name}</b> принял(а) ваш огонёк!\n\nОгонёк активирован. Пишите друг другу каждый день 💬")

@dp.callback_query(F.data.startswith("decline:"))
async def decline(c:CallbackQuery):
    sid=int(c.data.split(":")[1])
    spark=await pending_for_recipient(sid,c.from_user.id)
    if not spark:
        await c.answer("Приглашение недоступно",show_alert=True); return
    await db.decline_spark(sid)
    await c.message.edit_text("❌ Приглашение отклонено.")
    await c.answer()

async def pending_for_recipient(sid,uid):
    async with db.lock:
        c=db.conn()
        try:
            return c.execute("SELECT * FROM sparks WHERE id=? AND partner_id=? AND status='pending'",(sid,uid)).fetchone()
        finally: c.close()

async def process_business_message(m:Message):
    # Aiogram exposes business messages as Message objects. business_connection_id
    # is present when the update belongs to a Business Connection.
    if not getattr(m,"business_connection_id",None):
        return
    owner_id=m.business_connection_id  # used below only as connection key, not Telegram user id
    sender=m.from_user.id if m.from_user else None
    if not sender: return
    # Find active sparks where sender is one side.
    sparks=await db.active_for_user(sender)
    for s in sparks:
        side="owner" if s["owner_id"]==sender else "partner"
        became,row=await db.mark_activity(s["id"],day(),side)
        if became:
            st=await db.state(s["id"])
            old=st["streak"] if st else 0
            prev=(now().date()-timedelta(days=1)).isoformat()
            prevrow=await db.today_activity(s["id"],prev)
            streak=old+1 if old>0 and prevrow and prevrow["counted"] else 1
            await db.set_state(s["id"],streak,day())
            owner=s["owner_id"]; partner=s["partner_id"]
            text=f"🔥 <b>Огонёк {days(streak)}!</b>\n\nВы держите огонёк уже <b>{days(streak)}</b> подряд.\nОба сегодня пообщались — день засчитан 🔥"
            await bot.send_message(owner,text)
            await bot.send_message(partner,text)

@dp.message()
async def all_messages(m:Message):
    try:
        await db.upsert_user(m.from_user,now().isoformat())
        await process_business_message(m)
    except Exception:
        log.exception("message processing error")

async def reminder_loop():
    while True:
        try:
            n=now()
            target=n.replace(hour=cfg.reminder_hour,minute=cfg.reminder_minute,second=0,microsecond=0)
            if target<=n: target+=timedelta(days=1)
            await asyncio.sleep((target-n).total_seconds())
            today_str=day()
            for s in await db.all_active():
                a=await db.today_activity(s["id"],today_str)
                if not a or not (a["owner_active"] and a["partner_active"]):
                    owner=s["owner_id"]; partner=s["partner_id"]
                    if a and a["owner_active"] and not a["partner_active"]:
                        await bot.send_message(owner,"⏳ <b>Огонёк ждёт второго участника!</b>\n\nНапишите друг другу сегодня, чтобы сохранить серию 🔥")
                        await bot.send_message(partner,"⏳ <b>Вас ждут в огоньке!</b>\n\nНапишите друг другу сегодня, чтобы сохранить серию 🔥")
                    elif a and a["partner_active"] and not a["owner_active"]:
                        await bot.send_message(owner,"⏳ <b>Огонёк ждёт вас!</b>\n\nСегодня второй участник уже написал. Ответьте, чтобы сохранить серию 🔥")
                        await bot.send_message(partner,"⏳ <b>Огонёк ждёт второго участника!</b>\n\nНапишите друг другу сегодня, чтобы сохранить серию 🔥")
        except asyncio.CancelledError:
            raise
        except Exception:
            log.exception("reminder loop error")

async def main():
    await db.init()
    log.info("Ogonek Business Bot started")
    task=asyncio.create_task(reminder_loop())
    try:
        await dp.start_polling(bot, allowed_updates=dp.resolve_used_update_types()+["business_message"])
    finally:
        task.cancel()
        await bot.session.close()

if __name__=="__main__":
    asyncio.run(main())
